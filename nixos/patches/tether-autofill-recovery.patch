+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { readFileSync } from 'node:fs';
+import { runInNewContext } from 'node:vm';
+import { JSDOM } from 'jsdom';
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.resetModules();
+});
+afterEach(() => {
+  vi.clearAllTimers();
+  vi.useRealTimers();
+  delete global.chrome;
+  delete global.browser;
+});
+
+function nativeHarness() {
+  const ports = [];
+  global.browser = undefined;
+  global.chrome = { runtime: {
+    connectNative: vi.fn(() => {
+      const port = {
+        postMessage: vi.fn(),
+        onMessage: { addListener(callback) { port.message = callback; } },
+        onDisconnect: { addListener(callback) { port.disconnect = callback; } },
+      };
+      ports.push(port);
+      return port;
+    }),
+  } };
+  return ports;
+}
+
+describe('native bridge recovery', () => {
+  it('reconnects without a webpage request, and records recovery only after a reply', async () => {
+    const ports = nativeHarness();
+    const native = await import('../src/shared/native.js');
+    native.connectToNativeHost();
+    ports[0].disconnect(ports[0]);
+    vi.advanceTimersByTime(999);
+    expect(ports).toHaveLength(1);
+    vi.advanceTimersByTime(1);
+    expect(ports).toHaveLength(2);
+    expect(ports[1].postMessage).not.toHaveBeenCalled();
+    ports[1].message({ command: 'protocol_info' });
+    expect(ports[1].postMessage).toHaveBeenCalledExactlyOnceWith({
+      command: 'autofill_diagnostic', event: 'bridge_recovered',
+    });
+  });
+
+  it('backs off repeated failures and resets the delay after a healthy reply', async () => {
+    const ports = nativeHarness();
+    const native = await import('../src/shared/native.js');
+    native.connectToNativeHost();
+    ports[0].disconnect(ports[0]);
+    vi.advanceTimersByTime(1000);
+    ports[1].disconnect(ports[1]);
+    vi.advanceTimersByTime(1999);
+    expect(ports).toHaveLength(2);
+    vi.advanceTimersByTime(1);
+    expect(ports).toHaveLength(3);
+    ports[2].message({ command: 'protocol_info' });
+    ports[2].disconnect(ports[2]);
+    vi.advanceTimersByTime(1000);
+    expect(ports).toHaveLength(4);
+  });
+
+  it('ignores a late disconnect from an older port', async () => {
+    const ports = nativeHarness();
+    const native = await import('../src/shared/native.js');
+    native.connectToNativeHost();
+    native.connectToNativeHost();
+    ports[0].disconnect(ports[0]);
+    vi.advanceTimersByTime(30000);
+    expect(ports).toHaveLength(2);
+    native.sendToNativeHost({ command: 'protocol_info' });
+    expect(ports[1].postMessage).toHaveBeenCalledWith({ command: 'protocol_info' });
+  });
+});
+
+function contentHarness() {
+  const dom = new JSDOM('<input autocomplete="one-time-code" maxlength="6">', {
+    url: 'https://example.test',
+  });
+  const doc = dom.window.document;
+  Object.defineProperty(doc, 'visibilityState', { configurable: true, writable: true, value: 'visible' });
+  let receive;
+  const send = vi.fn();
+  const source = readFileSync(new URL('../src/content/autofill.js', import.meta.url), 'utf8')
+    .replace(/export /g, '');
+  runInNewContext(source, {
+    document: doc, window: dom.window,
+    chrome: { runtime: { sendMessage: send, onMessage: { addListener(callback) { receive = callback; } } } },
+    setInterval, clearInterval,
+  });
+  const requestCount = () => send.mock.calls.filter(([message]) => message.action === 'request_otp_for_site').length;
+  return { dom, doc, send, requestCount, receive };
+}
+
+describe('expired OTP flow recovery', () => {
+  it.each(['visibilitychange', 'focusin', 'click'])('resumes on %s after the two-minute timeout', event => {
+    const harness = contentHarness();
+    vi.advanceTimersByTime(122000);
+    expect(harness.requestCount()).toBe(61);
+    expect(harness.send).toHaveBeenCalledWith({ action: 'autofill_diagnostic', event: 'poll_timeout' });
+    harness.doc.dispatchEvent(new harness.dom.window.Event(event));
+    expect(harness.requestCount()).toBe(62);
+    expect(harness.send).toHaveBeenCalledWith({ action: 'autofill_diagnostic', event: 'poll_resumed' });
+    harness.dom.window.close();
+  });
+
+  it('does not resume in a hidden tab or overwrite an entered code', () => {
+    const harness = contentHarness();
+    vi.advanceTimersByTime(122000);
+    harness.doc.visibilityState = 'hidden';
+    harness.doc.dispatchEvent(new harness.dom.window.Event('click'));
+    expect(harness.requestCount()).toBe(61);
+    harness.doc.visibilityState = 'visible';
+    harness.doc.querySelector('input').value = '12';
+    harness.doc.dispatchEvent(new harness.dom.window.Event('focusin'));
+    expect(harness.requestCount()).toBe(61);
+    expect(harness.doc.querySelector('input').value).toBe('12');
+    harness.dom.window.close();
+  });
+
+  it('records a successful fill without putting the code or URL in its diagnostic', () => {
+    const harness = contentHarness();
+    const respond = vi.fn();
+    harness.receive({ action: 'fill_otp', otp: '123456', otp_id: 9 }, {}, respond);
+    expect(respond).toHaveBeenCalledWith({ filled: true });
+    expect(harness.send).toHaveBeenCalledWith({ action: 'autofill_diagnostic', event: 'filled' });
+    const diagnostics = harness.send.mock.calls.map(([message]) => message)
+      .filter(message => message.action === 'autofill_diagnostic');
+    expect(JSON.stringify(diagnostics)).not.toContain('123456');
+    expect(JSON.stringify(diagnostics)).not.toContain('example.test');
+    const before = harness.requestCount();
+    harness.doc.dispatchEvent(new harness.dom.window.Event('focusin'));
+    expect(harness.requestCount()).toBe(before);
+    harness.dom.window.close();
+  });
+});
