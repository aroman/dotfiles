     // Advice for the user, phrased so it can be shown verbatim.
     std::string obex_error_advice(ObexError error, const std::string& profile);

+    // Mirrors obexd's login policy. If login detection is unavailable, obexd
+    // disables that policy, so callers may continue without a local seat.
+    bool obex_login_ready();
+
     // Session operations on obexd.
     class ProfileOps {
     public:
         virtual ~ProfileOps() = default;
+
+        // Whether opening a session can activate obexd right now. A deferred
+        // attempt is not a phone/profile error and must not consume backoff.
+        virtual bool can_create_session() const { return true; }

         // Returns the new session's object path, or an empty string with err set.
         virtual std::string create_session(const std::string& target, std::string& err) = 0;
