 namespace tether::bluetooth {

@@ -21,6 +25,20 @@
         }

     } // namespace
+
+    bool obex_login_ready() {
+        char* state = nullptr;
+        if (sd_uid_get_state(getuid(), &state) < 0)
+            return true; // Like obexd, fall back when login detection is unavailable.
+        const bool active = state && std::strcmp(state, "active") == 0;
+        std::free(state);
+        if (!active)
+            return false;
+
+        // An active SSH session alone is insufficient: obexd also requires
+        // an active session on a local seat. Query failures disable its policy.
+        return sd_uid_get_seats(getuid(), 1, nullptr) != 0;
+    }

     const char* to_string(ObexError error) {
         switch (error) {
@@ -185,6 +203,13 @@
             return !(status_ == previous);
         }

+        // A lingering user manager can run before login. BlueZ defers its
+        // transport then, and activating obexd makes server initialization fail.
+        if (!ops_.can_create_session()) {
+            status_.reason = _("Not connected yet.");
+            return !(status_ == previous);
+        }
+
         if (now < next_attempt_)
             return !(status_ == previous);

