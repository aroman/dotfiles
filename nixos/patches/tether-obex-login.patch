@@ -1139,3 +1141,75 @@
     const BearerStatus gone = gone_bearer();
     EXPECT_FALSE(should_lock_on_away(true, gone, false, REASON_TIMEOUT, 300, -1, 30));
 }
+
+
+TEST(ProfileSupervisor, DefersObexActivationUntilLocalLogin) {
+    FakeProfiles ops;
+    ops.login_ready = false;
+    ProfileSupervisor sup(ops);
+
+    sup.tick(0, true);
+    sup.tick(60, true);
+    EXPECT_EQ(ops.map_attempts, 0);
+    EXPECT_EQ(ops.pbap_attempts, 0);
+    EXPECT_FALSE(sup.status().map_open);
+    EXPECT_FALSE(sup.status().pbap_open);
+    EXPECT_EQ(sup.status().map_error, ObexError::None);
+    EXPECT_EQ(sup.status().pbap_error, ObexError::None);
+
+    // Logging in opens both sessions on the next tick, without retry delay.
+    ops.login_ready = true;
+    sup.tick(61, true);
+    EXPECT_EQ(ops.map_attempts, 1);
+    EXPECT_EQ(ops.pbap_attempts, 1);
+    EXPECT_TRUE(sup.status().map_open);
+    EXPECT_TRUE(sup.status().pbap_open);
+}
+
+TEST(ProfileSupervisor, DeferredAttemptDoesNotConsumeInitialBackoff) {
+    FakeProfiles ops;
+    ops.login_ready = false;
+    ProfileSupervisor sup(ops);
+    sup.tick(0, true);
+
+    ops.login_ready = true;
+    sup.tick(1, true);
+    EXPECT_EQ(ops.map_attempts, 1);
+    EXPECT_EQ(ops.pbap_attempts, 1);
+}
+
+TEST(ProfileSupervisor, DoesNotRetryMissingProfileWithoutLocalLogin) {
+    FakeProfiles ops;
+    ops.pbap_error = "Connection refused (111)";
+    ProfileSupervisor sup(ops);
+    sup.tick(0, true);
+    ASSERT_TRUE(sup.status().map_open);
+    ASSERT_FALSE(sup.status().pbap_open);
+
+    ops.login_ready = false;
+    sup.tick(60, true);
+    EXPECT_EQ(ops.map_attempts, 1);
+    EXPECT_EQ(ops.pbap_attempts, 1);
+    EXPECT_TRUE(ops.removed.empty());
+
+    ops.login_ready = true;
+    ops.pbap_error.clear();
+    sup.tick(61, true);
+    EXPECT_EQ(ops.map_attempts, 1);
+    EXPECT_EQ(ops.pbap_attempts, 2);
+    EXPECT_TRUE(sup.status().pbap_open);
+}
+
+TEST(ProfileSupervisor, LoginGateDoesNotTearDownOpenSessions) {
+    FakeProfiles ops;
+    ProfileSupervisor sup(ops);
+    sup.tick(0, true);
+
+    ops.login_ready = false;
+    sup.tick(60, true);
+    EXPECT_TRUE(sup.status().map_open);
+    EXPECT_TRUE(sup.status().pbap_open);
+    EXPECT_EQ(ops.map_attempts, 1);
+    EXPECT_EQ(ops.pbap_attempts, 1);
+    EXPECT_TRUE(ops.removed.empty());
+}
