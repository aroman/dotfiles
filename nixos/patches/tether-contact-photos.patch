+    std::filesystem::path contact_photo_dir() {
+        return std::filesystem::path(g_get_user_cache_dir()) / "tether" / "contact-photos";
+    }
+
+    std::string contact_photo_key(const std::string& tel_or_thread_key) {
+        std::string digits;
+        for (char c : tel_or_thread_key)
+            if (c >= '0' && c <= '9')
+                digits.push_back(c);
+        return digits.size() > 10 ? digits.substr(digits.size() - 10) : digits;
+    }
+
+    void write_contact_photos(const std::vector<VCard>& cards) {
+        const std::filesystem::path dir = contact_photo_dir();
+        std::error_code ec;
+        std::filesystem::remove_all(dir, ec);
+        std::filesystem::create_directories(dir, ec);
+        if (ec)
+            return;
+        std::filesystem::permissions(dir, std::filesystem::perms::owner_all, ec);
+        for (const auto& card : cards) {
+            if (card.photo.size() < 4)
+                continue;
+            const bool png = static_cast<unsigned char>(card.photo[0]) == 0x89 && card.photo[1] == 'P';
+            for (const auto& tel : card.tels) {
+                const std::string key = contact_photo_key(tel);
+                if (key.size() < 7)
+                    continue;
+                std::ofstream out(dir / (key + (png ? ".png" : ".jpg")), std::ios::binary | std::ios::trunc);
+                out.write(card.photo.data(), static_cast<std::streamsize>(card.photo.size()));
+            }
+        }
+    }
+
+    std::string contact_photo_for(const std::string& thread_key) {
+        if (thread_key.rfind("tel:", 0) != 0)
+            return {};
+        const std::string key = contact_photo_key(thread_key);
+        if (key.size() < 7)
+            return {};
+        std::error_code ec;
+        for (const char* ext : {".jpg", ".png"}) {
+            const std::filesystem::path p = contact_photo_dir() / (key + ext);
+            if (std::filesystem::exists(p, ec))
+                return p.string();
+        }
+        return {};
+    }
+
 } // namespace tether::bluetooth
