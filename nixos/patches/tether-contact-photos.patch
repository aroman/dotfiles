+TEST(VCard, PhotoDecodingPreservesCallHistoryFields) {
+    auto cards = parse_vcards("BEGIN:VCARD\r\n"
+                              "FN:Caller\r\n"
+                              "TEL:+15551234567\r\n"
+                              "PHOTO;ENCODING=b;TYPE=JPEG:/9j/\r\n"
+                              " 2Q==\r\n"
+                              "X-IRMC-CALL-DATETIME;MISSED:20261010T120000\r\n"
+                              "END:VCARD\r\n");
+    ASSERT_EQ(cards.size(), 1u);
+    EXPECT_EQ(cards[0].photo, std::string("\xff\xd8\xff\xd9", 4));
+    EXPECT_EQ(cards[0].call_type, "MISSED");
+    EXPECT_EQ(cards[0].call_time, "20261010T120000");
+}
+
+TEST(VCard, RemotePhotoIsNotDecodedAsBase64) {
+    auto cards = parse_vcards("BEGIN:VCARD\nFN:Caller\n"
+                              "PHOTO;VALUE=URI:https://example.com/photo.jpg\nEND:VCARD\n");
+    ASSERT_EQ(cards.size(), 1u);
+    EXPECT_TRUE(cards[0].photo.empty());
+}
