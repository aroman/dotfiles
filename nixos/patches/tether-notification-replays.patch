+TEST(AncsRegistry, UnchangedMissedCallUpdatesDoNotRepeatThePopup) {
+    NotificationRegistry registry;
+    Notification call = make(7, "com.apple.mobilephone");
+    call.category = CategoryId::MissedCall;
+    call.title = "Caller";
+    call.body = "Missed call";
+    call.received = 100;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+
+    // iOS updates flags and dates on existing missed calls when another call
+    // arrives. Resolve those updates without raising the old call again.
+    call.has_negative_action = true;
+    call.received = 200;
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+    ASSERT_EQ(registry.size(), 1u);
+    EXPECT_TRUE(registry.find(7)->has_negative_action);
+    EXPECT_EQ(registry.find(7)->received, 200);
+}
+
+TEST(AncsRegistry, BacklogStaysQuietWhenAModificationDropsPreExisting) {
+    NotificationRegistry registry;
+    Notification call = make(7, "com.apple.mobilephone");
+    call.category = CategoryId::MissedCall;
+    call.pre_existing = true;
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+
+    call.pre_existing = false;
+    call.body = "Updated missed call details";
+    const Notification updated = registry.store(call);
+    EXPECT_TRUE(updated.pre_existing);
+    EXPECT_FALSE(should_show_desktop_popup(updated));
+}
+
+TEST(AncsRegistry, ReconnectReplayStaysQuietEvenWithoutPreExisting) {
+    NotificationRegistry registry;
+    Notification call = make(7, "com.apple.mobilephone");
+    call.category = CategoryId::MissedCall;
+    call.title = "Caller";
+    call.received = 100;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+
+    registry.begin_session();
+    call.uid = 29;
+    const Notification replay = registry.store(call);
+    EXPECT_FALSE(should_show_desktop_popup(replay));
+    EXPECT_TRUE(replay.pre_existing);
+    EXPECT_EQ(registry.find(7), nullptr);
+    EXPECT_EQ(registry.size(), 1u);
+
+    // Subsequent updates must inherit the replay's quiet delivery status.
+    call.body = "Updated missed call details";
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+}
+
+TEST(AncsRegistry, SeparateCallsWithIdenticalTextStillAlert) {
+    NotificationRegistry registry;
+    Notification call = make(7, "com.apple.mobilephone");
+    call.category = CategoryId::MissedCall;
+    call.title = "Caller";
+    call.received = 100;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+
+    call.uid = 8;
+    call.received = 200;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+
+    registry.begin_session();
+    call.uid = 7; // UIDs can be recycled on a new connection.
+    call.received = 300;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+}
+
+TEST(AncsRegistry, ACallBecomingMissedAlertsOnceForTheNewState) {
+    NotificationRegistry registry;
+    Notification call = make(7, "com.apple.mobilephone");
+    call.category = CategoryId::IncomingCall;
+    call.title = "Caller";
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+
+    call.category = CategoryId::MissedCall;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+}
+
+TEST(AncsRegistry, ChangedContentStillAlertsForALiveNotification) {
+    NotificationRegistry registry;
+    Notification notification = make(7, "com.example.chat");
+    notification.body = "First message";
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+
+    notification.body = "Edited message";
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(notification)));
+}
+
+TEST(AncsRegistry, ARingingCallFromBeforeReconnectCanBecomeANewMissedCall) {
+    NotificationRegistry registry;
+    Notification call = make(7, "com.apple.mobilephone");
+    call.category = CategoryId::IncomingCall;
+    call.pre_existing = true;
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+
+    call.pre_existing = false;
+    call.category = CategoryId::MissedCall;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+}
+
+TEST(AncsRegistry, RemovedNotificationsDoNotSuppressLaterCalls) {
+    NotificationRegistry registry;
+    Notification call = make(7, "com.apple.mobilephone");
+    call.category = CategoryId::MissedCall;
+    registry.store(call);
+    registry.forget(call.uid);
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+}
+
+TEST(AncsRegistry, FreshDaemonDoesNotPopupOldWalletBacklogWithoutPreExisting) {
+    NotificationRegistry registry;
+    registry.begin_session(100000);
+    Notification wallet = make(18, "com.apple.Passbook");
+    wallet.title = "Wallet notification";
+    wallet.received = 1000; // First arrival after restart, originally delivered days ago.
+    wallet.pre_existing = false; // Observed on the live phone's Wallet replay.
+    const Notification backlog = registry.store(wallet);
+    EXPECT_TRUE(backlog.pre_existing);
+    EXPECT_FALSE(should_show_desktop_popup(backlog));
+    EXPECT_EQ(registry.size(), 1u) << "the backlog must remain visible in the list";
+
+    wallet.uid = 19; // A second retained notification with the same text.
+    wallet.received = 2000;
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(wallet)));
+
+    registry.begin_session(110000);
+    wallet.uid = 30;
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(wallet)));
+}
+
+TEST(AncsRegistry, SubscriptionDateCheckAllowsNewNotificationsAndDeliveryGrace) {
+    NotificationRegistry registry;
+    registry.begin_session(1000);
+    Notification notification = make(1, "com.apple.Passbook");
+    notification.received = 995; // Arrived while StartNotify was completing.
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+
+    notification.uid = 2;
+    notification.received = 1000;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+
+    notification.uid = 3;
+    notification.received = 1010;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+
+    notification.uid = 4;
+    notification.received = 0; // An unknown date cannot establish that it is old.
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+}
+
+TEST(AncsRegistry, OldRingingCallCanBecomeNewlyMissedAfterSubscription) {
+    NotificationRegistry registry;
+    registry.begin_session(1000);
+    Notification call = make(1, "com.apple.mobilephone");
+    call.category = CategoryId::IncomingCall;
+    call.received = 900;
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+
+    call.category = CategoryId::MissedCall;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(call)));
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(call)));
+}
+
+TEST(AncsRegistry, RecycledUidAfterReconnectDoesNotExemptOldBacklogFromDateCheck) {
+    NotificationRegistry registry;
+    registry.begin_session(1000);
+    Notification notification = make(1, "com.apple.Passbook");
+    notification.received = 1000;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+
+    registry.begin_session(2000);
+    notification.received = 500;
+    notification.body = "Another old notification under the recycled UID";
+    EXPECT_FALSE(should_show_desktop_popup(registry.store(notification)));
+
+    notification.uid = 2;
+    notification.received = 2000;
+    EXPECT_TRUE(should_show_desktop_popup(registry.store(notification)));
+}
