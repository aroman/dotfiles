diff --git a/src/daemon/app_icon.cpp b/src/daemon/app_icon.cpp
new file mode 100644
index 0000000..c446c4f
--- /dev/null
+++ b/src/daemon/app_icon.cpp
@@ -0,0 +1,132 @@
+#include "app_icon.hpp"
+
+#include <curl/curl.h>
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <glib.h>
+#include <nlohmann/json.hpp>
+
+#include <chrono>
+#include <filesystem>
+#include <memory>
+
+namespace tether {
+
+    namespace {
+
+        constexpr size_t MAX_DOWNLOAD_BYTES = 2 * 1024 * 1024;
+
+        std::filesystem::path icon_path(const std::string& app_id) {
+            // Bundle IDs become filenames, so reject path and URL separators.
+            if (app_id.empty() || app_id.size() > 200 ||
+                app_id.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_") !=
+                    std::string::npos)
+                return {};
+            return std::filesystem::path(g_get_user_cache_dir()) / "tether/app-icons" / (app_id + ".png");
+        }
+
+        std::string download_icon_url(const std::string& url) {
+            static const auto curl_initialized = curl_global_init(CURL_GLOBAL_DEFAULT);
+            if (curl_initialized != CURLE_OK)
+                return {};
+            std::unique_ptr<CURL, decltype(&curl_easy_cleanup)> curl(curl_easy_init(), curl_easy_cleanup);
+            if (!curl)
+                return {};
+
+            std::string data;
+            curl_easy_setopt(curl.get(), CURLOPT_URL, url.c_str());
+            curl_easy_setopt(curl.get(), CURLOPT_PROTOCOLS_STR, "https");
+            curl_easy_setopt(curl.get(), CURLOPT_REDIR_PROTOCOLS_STR, "https");
+            curl_easy_setopt(curl.get(), CURLOPT_FOLLOWLOCATION, 1L);
+            curl_easy_setopt(curl.get(), CURLOPT_MAXREDIRS, 3L);
+            curl_easy_setopt(curl.get(), CURLOPT_FAILONERROR, 1L);
+            curl_easy_setopt(curl.get(), CURLOPT_NOSIGNAL, 1L);
+            curl_easy_setopt(curl.get(), CURLOPT_CONNECTTIMEOUT_MS, 1000L);
+            curl_easy_setopt(curl.get(), CURLOPT_TIMEOUT_MS, 2000L);
+            curl_easy_setopt(curl.get(), CURLOPT_WRITEFUNCTION,
+                             +[](char* bytes, size_t size, size_t count, void* output) -> size_t {
+                                 auto& body = *static_cast<std::string*>(output);
+                                 const size_t length = size * count;
+                                 if (length > MAX_DOWNLOAD_BYTES - body.size())
+                                     return 0;
+                                 body.append(bytes, length);
+                                 return length;
+                             });
+            curl_easy_setopt(curl.get(), CURLOPT_WRITEDATA, &data);
+            if (curl_easy_perform(curl.get()) != CURLE_OK)
+                data.clear();
+            return data;
+        }
+
+        std::string artwork_url(const std::string& app_id, const std::string& response) {
+            const auto metadata = nlohmann::json::parse(response, nullptr, false);
+            if (!metadata.is_object() || !metadata.contains("results") || !metadata["results"].is_array())
+                return {};
+            std::string url;
+            for (const auto& result : metadata["results"]) {
+                if (!result.is_object() || !result.contains("bundleId") || result["bundleId"] != app_id)
+                    continue;
+                if (result.contains("artworkUrl512") && result["artworkUrl512"].is_string())
+                    url = result["artworkUrl512"].get<std::string>();
+                else if (result.contains("artworkUrl100") && result["artworkUrl100"].is_string())
+                    url = result["artworkUrl100"].get<std::string>();
+                break;
+            }
+            g_autoptr(GUri) uri = g_uri_parse(url.c_str(), G_URI_FLAGS_NONE, nullptr);
+            const std::string host = uri && g_uri_get_host(uri) ? g_uri_get_host(uri) : "";
+            const bool allowed = uri && g_uri_get_scheme(uri) && std::string(g_uri_get_scheme(uri)) == "https" &&
+                                 host.ends_with(".mzstatic.com");
+            return allowed ? url : std::string{};
+        }
+
+        bool cache_image(const std::filesystem::path& path, const std::string& bytes) {
+            // Decode and normalize the downloaded image before it enters the cache.
+            g_autoptr(GdkPixbufLoader) loader = gdk_pixbuf_loader_new();
+            gdk_pixbuf_loader_set_size(loader, 128, 128);
+            const bool written = gdk_pixbuf_loader_write(
+                loader, reinterpret_cast<const guchar*>(bytes.data()), bytes.size(), nullptr);
+            const bool closed = gdk_pixbuf_loader_close(loader, nullptr);
+            GdkPixbuf* pixbuf = written && closed ? gdk_pixbuf_loader_get_pixbuf(loader) : nullptr;
+            g_autofree gchar* png = nullptr;
+            gsize length = 0;
+            return pixbuf && gdk_pixbuf_save_to_buffer(pixbuf, &png, &length, "png", nullptr, nullptr) &&
+                   g_file_set_contents(path.c_str(), png, length, nullptr);
+        }
+
+    } // namespace
+
+    std::string cached_app_icon(const std::string& app_id) {
+        const auto icon = icon_path(app_id);
+        std::error_code ec;
+        return !icon.empty() && std::filesystem::is_regular_file(icon, ec) ? icon.string() : std::string{};
+    }
+
+    std::string app_icon_for(const std::string& app_id, IconDownload download) {
+        const auto icon = icon_path(app_id);
+        if (icon.empty())
+            return {};
+        const auto cached = cached_app_icon(app_id);
+        if (!cached.empty())
+            return cached;
+        auto miss = icon;
+        miss.replace_extension(".miss");
+        std::error_code ec;
+        const auto attempted = std::filesystem::last_write_time(miss, ec);
+        if (!ec && std::filesystem::file_time_type::clock::now() - attempted < std::chrono::hours(1))
+            return {};
+        ec.clear();
+        std::filesystem::create_directories(icon.parent_path(), ec);
+        if (ec || !g_file_set_contents(miss.c_str(), "", 0, nullptr))
+            return {};
+        if (!download)
+            download = download_icon_url;
+
+        // Only the bundle ID goes to Apple, never notification text or contacts.
+        const auto url = artwork_url(
+            app_id, download("https://itunes.apple.com/lookup?bundleId=" + app_id + "&entity=software"));
+        if (url.empty() || !cache_image(icon, download(url)))
+            return {};
+        std::filesystem::remove(miss, ec);
+        return icon.string();
+    }
+
+} // namespace tether
