diff --git a/test/test_app_icon.cpp b/test/test_app_icon.cpp
new file mode 100644
index 0000000..f257fdf
--- /dev/null
+++ b/test/test_app_icon.cpp
@@ -0,0 +1,111 @@
+#include "app_icon.hpp"
+
+#include <gdk-pixbuf/gdk-pixbuf.h>
+#include <gtest/gtest.h>
+#include <nlohmann/json.hpp>
+
+#include <chrono>
+#include <filesystem>
+
+namespace {
+    std::string image() {
+        GdkPixbuf* pixbuf = gdk_pixbuf_new(GDK_COLORSPACE_RGB, true, 8, 16, 16);
+        gdk_pixbuf_fill(pixbuf, 0x123456ff);
+        gchar* buffer = nullptr;
+        gsize size = 0;
+        gdk_pixbuf_save_to_buffer(pixbuf, &buffer, &size, "png", nullptr, nullptr);
+        std::string bytes(buffer, size);
+        g_free(buffer);
+        g_object_unref(pixbuf);
+        return bytes;
+    }
+
+    std::string metadata(const std::string& id, const std::string& url = "https://is1-ssl.mzstatic.com/icon.png") {
+        return nlohmann::json{{"results", {{{"bundleId", id}, {"artworkUrl512", url}}}}}.dump();
+    }
+}
+
+TEST(AppIcon, RejectsPathsBeforeFetching) {
+    for (const std::string& id : {"", "../outside", "com.app/id", "com.app?other=value"})
+        EXPECT_TRUE(tether::app_icon_for(id, [](const auto&) -> std::string {
+            ADD_FAILURE() << "Invalid ID triggered a lookup";
+            return {};
+        }).empty());
+}
+
+TEST(AppIcon, MatchesBundleIdNormalizesAndCachesArtwork) {
+    int requests = 0;
+    const auto fetch = [&](const std::string& url) {
+        ++requests;
+        if (url.starts_with("https://itunes.apple.com/lookup?bundleId=com.test.cached&"))
+            return metadata("com.test.cached");
+        return image();
+    };
+    const auto path = tether::app_icon_for("com.test.cached", fetch);
+    ASSERT_FALSE(path.empty());
+    EXPECT_EQ(requests, 2);
+    GdkPixbuf* pixbuf = gdk_pixbuf_new_from_file(path.c_str(), nullptr);
+    ASSERT_NE(pixbuf, nullptr);
+    EXPECT_EQ(gdk_pixbuf_get_width(pixbuf), 128);
+    g_object_unref(pixbuf);
+    EXPECT_EQ(tether::app_icon_for("com.test.cached", fetch), path);
+    EXPECT_EQ(tether::cached_app_icon("com.test.cached"), path);
+    EXPECT_EQ(requests, 2);
+}
+
+TEST(AppIcon, IgnoresArtworkForADifferentBundle) {
+    int requests = 0;
+    EXPECT_TRUE(tether::app_icon_for("com.test.mismatch", [&](const auto&) {
+        ++requests;
+        return metadata("com.other.app");
+    }).empty());
+    EXPECT_EQ(requests, 1);
+}
+
+TEST(AppIcon, RetriesFailedLookupsAfterAnHour) {
+    int requests = 0;
+    const auto fetch = [&](const auto&) { ++requests; return std::string{}; };
+    EXPECT_TRUE(tether::app_icon_for("com.test.offline", fetch).empty());
+    EXPECT_TRUE(tether::app_icon_for("com.test.offline", fetch).empty());
+    EXPECT_EQ(requests, 1);
+    const auto miss = std::filesystem::path(g_get_user_cache_dir()) / "tether/app-icons/com.test.offline.miss";
+    std::filesystem::last_write_time(miss, std::filesystem::file_time_type::clock::now() - std::chrono::hours(2));
+    EXPECT_TRUE(tether::app_icon_for("com.test.offline", fetch).empty());
+    EXPECT_EQ(requests, 2);
+}
+
+TEST(AppIcon, RejectsNonAppleArtworkAndInvalidImageData) {
+    int requests = 0;
+    EXPECT_TRUE(tether::app_icon_for("com.test.host", [&](const auto&) {
+        ++requests;
+        return metadata("com.test.host", "https://mzstatic.com.example.org/icon.png");
+    }).empty());
+    EXPECT_EQ(requests, 1);
+    EXPECT_TRUE(tether::app_icon_for("com.test.image", [](const std::string& url) {
+        return url.starts_with("https://itunes.apple.com/") ? metadata("com.test.image") : "not an image";
+    }).empty());
+    EXPECT_FALSE(std::filesystem::exists(std::filesystem::path(g_get_user_cache_dir()) /
+                                         "tether/app-icons/com.test.image.png"));
+}
+
+TEST(AppIcon, DoesNotDownloadWhenCacheCannotBeWritten) {
+    const auto miss = std::filesystem::path(g_get_user_cache_dir()) / "tether/app-icons/com.test.unwritable.miss";
+    std::filesystem::create_directories(miss);
+    std::filesystem::last_write_time(miss, std::filesystem::file_time_type::clock::now() - std::chrono::hours(2));
+    EXPECT_TRUE(tether::app_icon_for("com.test.unwritable", [](const auto&) -> std::string {
+        ADD_FAILURE() << "Unwritable cache triggered a download";
+        return {};
+    }).empty());
+}
+
+int main(int argc, char** argv) {
+    gchar* cache = g_dir_make_tmp("tether-app-icon-test-XXXXXX", nullptr);
+    if (!cache)
+        return 1;
+    g_setenv("XDG_CACHE_HOME", cache, true);
+    testing::InitGoogleTest(&argc, argv);
+    const int status = RUN_ALL_TESTS();
+    std::filesystem::remove_all(cache);
+    g_free(cache);
+    return status;
+}
diff --git a/test/test_notification_icons.cpp b/test/test_notification_icons.cpp
new file mode 100644
index 0000000..e0518e0
--- /dev/null
+++ b/test/test_notification_icons.cpp
@@ -0,0 +1,165 @@
+#include "app_icon.hpp"
+#include "notification.hpp"
+
+#include <gio/gio.h>
+#include <gtest/gtest.h>
+#include <libnotify/notify.h>
+#include <tether/bluetooth/ancs/notifications.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <future>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace {
+    using namespace std::chrono_literals;
+
+    struct LookupState {
+        std::mutex mutex;
+        std::condition_variable changed;
+        std::atomic<bool> popups{true};
+        bool cached = false;
+        bool released = false;
+        bool finished = false;
+        bool cancelled = false;
+        bool barrier = false;
+        int calls = 0;
+        std::vector<std::string> shown;
+    } state;
+
+    class NotificationIcons : public testing::Test {
+    protected:
+        std::unique_ptr<tether::DesktopNotifier> notifier;
+
+        void SetUp() override {
+            state.popups = true;
+            state.cached = state.released = state.finished = state.cancelled = state.barrier = false;
+            state.calls = 0;
+            state.shown.clear();
+            notifier = std::make_unique<tether::DesktopNotifier>();
+            ASSERT_TRUE(notifier->init());
+        }
+
+        void TearDown() override {
+            release_lookup();
+            notifier.reset();
+        }
+
+        void send(const std::string& summary) {
+            tether::NotificationSpec spec;
+            spec.app_id = "com.test.notifications";
+            spec.summary = summary;
+            notifier->notify(spec);
+        }
+
+        template <class Predicate> bool wait_for(Predicate predicate) {
+            std::unique_lock lock(state.mutex);
+            return state.changed.wait_for(lock, 2s, predicate);
+        }
+
+        void release_lookup() {
+            std::lock_guard lock(state.mutex);
+            state.released = true;
+            state.changed.notify_all();
+        }
+    };
+}
+
+// Link-time seams keep these lifecycle tests independent of HTTP and D-Bus.
+namespace tether {
+    bool desktop_popups_enabled() { return state.popups; }
+
+    std::string cached_app_icon(const std::string&) {
+        std::lock_guard lock(state.mutex);
+        return state.cached ? "/missing-test-icon.png" : "";
+    }
+
+    std::string app_icon_for(const std::string&, IconDownload) {
+        std::unique_lock lock(state.mutex);
+        ++state.calls;
+        state.cached = true;
+        state.changed.notify_all();
+        state.changed.wait(lock, [] { return state.released; });
+        state.finished = true;
+        return "/missing-test-icon.png";
+    }
+
+    namespace bluetooth::ancs {
+        LaunchTarget launch_target(const std::string&) { return {}; }
+    }
+}
+
+extern "C" GCancellable* g_cancellable_new() {
+    auto* cancellable = G_CANCELLABLE(g_object_new(G_TYPE_CANCELLABLE, nullptr));
+    g_signal_connect(cancellable, "cancelled", G_CALLBACK(+[](GCancellable*, gpointer) {
+        std::lock_guard lock(state.mutex);
+        state.cancelled = true;
+        state.changed.notify_all();
+    }), nullptr);
+    return cancellable;
+}
+
+extern "C" gboolean notify_notification_show(NotifyNotification* notification, GError**) {
+    g_autofree gchar* summary = nullptr;
+    g_autofree gchar* body = nullptr;
+    g_object_get(notification, "summary", &summary, "body", &body, nullptr);
+    const bool barrier = body && std::string(body) == "barrier";
+    {
+        std::lock_guard lock(state.mutex);
+        if (barrier)
+            state.barrier = true;
+        else
+            state.shown.emplace_back(summary);
+        state.changed.notify_all();
+    }
+    if (barrier)
+        g_signal_emit_by_name(notification, "closed");
+    return true;
+}
+
+TEST_F(NotificationIcons, CoalescesArrivalsEvenAfterCacheIsWritten) {
+    send("first");
+    ASSERT_TRUE(wait_for([] { return state.calls == 1; }));
+    send("second");
+    notifier->notify_file_arrived("/tmp/barrier");
+    // This callback proves the loop processed 'second' while lookup is blocked.
+    ASSERT_TRUE(wait_for([] { return state.barrier; }));
+    {
+        std::lock_guard lock(state.mutex);
+        EXPECT_TRUE(state.shown.empty());
+        EXPECT_EQ(state.calls, 1);
+    }
+    release_lookup();
+    ASSERT_TRUE(wait_for([] { return state.shown.size() == 2; }));
+    std::lock_guard lock(state.mutex);
+    EXPECT_EQ(state.shown, (std::vector<std::string>{"first", "second"}));
+}
+
+TEST_F(NotificationIcons, DisablingPopupsSuppressesPendingDelivery) {
+    send("pending");
+    ASSERT_TRUE(wait_for([] { return state.calls == 1; }));
+    state.popups = false;
+    release_lookup();
+    EXPECT_FALSE(wait_for([] { return !state.shown.empty(); }));
+    std::lock_guard lock(state.mutex);
+    EXPECT_TRUE(state.finished);
+    EXPECT_TRUE(state.shown.empty());
+}
+
+TEST_F(NotificationIcons, ShutdownDrainsLookupWithoutDisplayingIt) {
+    send("pending");
+    ASSERT_TRUE(wait_for([] { return state.calls == 1; }));
+    auto shutdown = std::async(std::launch::async, [&] { notifier.reset(); });
+    EXPECT_TRUE(wait_for([] { return state.cancelled; }));
+    EXPECT_EQ(shutdown.wait_for(50ms), std::future_status::timeout);
+    release_lookup();
+    EXPECT_EQ(shutdown.wait_for(2s), std::future_status::ready);
+    shutdown.get();
+    std::lock_guard lock(state.mutex);
+    EXPECT_TRUE(state.finished);
+    EXPECT_TRUE(state.shown.empty());
+}
