#!/usr/bin/env node

import { execFileSync, spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import process from "node:process";
import { DatabaseSync } from "node:sqlite";

let shouldApply = false;
let inventory = false;
let inventorySort = null;
let missingOnly = false;
let verbose = false;
const worktreeRootArgs = [];
const directoryStateOrder = new Map([
  ["missing", 0],
  ["not-dir", 1],
  ["error", 2],
  ["exists", 3],
]);
const inventorySortComparators = new Map([
  ["size", (a, b) => b.bytes - a.bytes],
  ["threads", (a, b) => b.threads - a.threads],
  ["conversations", (a, b) => b.conversations - a.conversations],
  [
    "spawned",
    (a, b) =>
      b.threads - b.conversations - (a.threads - a.conversations),
  ],
  ["recent", (a, b) => b.updatedAt - a.updatedAt],
  ["oldest", (a, b) => a.updatedAt - b.updatedAt],
  ["path", (a, b) => a.cwd.localeCompare(b.cwd)],
  [
    "state",
    (a, b) => directoryStateOrder.get(a.state) - directoryStateOrder.get(b.state),
  ],
]);
const inventorySortFields = [...inventorySortComparators.keys()].join(", ");

/** Print command-line usage. */
function printUsage() {
  console.log(`Usage: codex-prune-orphaned-worktrees [options]

Options:
  --worktree-root PATH  Container whose immediate children are worktrees.
                        Repeat for multiple containers. Required unless using
                        --inventory.
  --inventory           List every recorded working directory with transcript
                        counts and sizes. Always read-only.
  --sort FIELD          Inventory order. One of:
                        ${inventorySortFields}. Default: size.
  --missing-only        Preserve existing but invalid worktree directories.
  --verbose             Print every orphaned working directory.
  --apply               Delete; without this flag, only report candidates.
  --help                 Show this help.`);
}

const rawArgs = process.argv.slice(2);
for (let index = 0; index < rawArgs.length; index += 1) {
  const arg = rawArgs[index];
  if (arg === "--apply") shouldApply = true;
  else if (arg === "--inventory") inventory = true;
  else if (arg === "--sort") {
    const field = rawArgs[index + 1];
    if (!field || field.startsWith("--")) {
      console.error("--sort requires a field");
      process.exit(2);
    }
    inventorySort = field;
    index += 1;
  } else if (arg === "--missing-only") missingOnly = true;
  else if (arg === "--verbose") verbose = true;
  else if (arg === "--worktree-root") {
    const root = rawArgs[index + 1];
    if (!root || root.startsWith("--")) {
      console.error("--worktree-root requires a path");
      process.exit(2);
    }
    worktreeRootArgs.push(root);
    index += 1;
  } else if (arg === "--help") {
    printUsage();
    process.exit(0);
  } else {
    console.error(`Unknown argument: ${arg}`);
    printUsage();
    process.exit(2);
  }
}

if (!inventory && inventorySort !== null) {
  console.error("--sort requires --inventory");
  process.exit(2);
}

if (inventorySort !== null && !inventorySortComparators.has(inventorySort)) {
  console.error(`Unknown inventory sort field: ${inventorySort}`);
  process.exit(2);
}

if (inventory) {
  const incompatibleOptions = [];
  if (shouldApply) incompatibleOptions.push("--apply");
  if (missingOnly) incompatibleOptions.push("--missing-only");
  if (verbose) incompatibleOptions.push("--verbose");
  if (worktreeRootArgs.length > 0) incompatibleOptions.push("--worktree-root");
  if (incompatibleOptions.length > 0) {
    console.error(
      `--inventory cannot be combined with ${incompatibleOptions.join(", ")}`,
    );
    process.exit(2);
  }
  inventorySort ??= "size";
} else if (worktreeRootArgs.length === 0) {
  console.error("At least one --worktree-root is required");
  printUsage();
  process.exit(2);
}

const codexHome = process.env.CODEX_HOME ?? path.join(os.homedir(), ".codex");
const codexBin = process.env.CODEX_BIN ?? "codex";

/** Find the newest Codex state database schema in CODEX_HOME. */
function findStateDatabase() {
  const matches = fs
    .readdirSync(codexHome)
    .map((name) => ({ name, match: /^state_(\d+)\.sqlite$/.exec(name) }))
    .filter(({ match }) => match !== null)
    .sort((a, b) => Number(b.match[1]) - Number(a.match[1]));

  if (matches.length === 0) {
    throw new Error(`No state_*.sqlite found under ${codexHome}`);
  }

  return path.join(codexHome, matches[0].name);
}

/** Validate and canonicalize an explicitly configured worktree container. */
function normalizeWorktreeRoot(root) {
  const absolute = path.resolve(root);
  if (!fs.existsSync(absolute) || !fs.statSync(absolute).isDirectory()) {
    throw new Error(`Worktree container does not exist: ${absolute}`);
  }
  return { absolute, canonical: fs.realpathSync.native(absolute) };
}

/** Return a relative path only when a candidate is inside a container. */
function relativeInside(container, candidate) {
  const relative = path.relative(container, candidate);
  if (relative === "") return relative;
  if (
    relative === ".." ||
    relative.startsWith(`..${path.sep}`) ||
    path.isAbsolute(relative)
  ) {
    return null;
  }
  return relative;
}

const worktreeRoots = worktreeRootArgs
  .map(normalizeWorktreeRoot)
  .sort((a, b) => b.absolute.length - a.absolute.length);

/** Find the configured container and immediate worktree child for a CWD. */
function findWorktreeBoundary(cwd) {
  const absoluteCwd = path.resolve(cwd);

  for (const root of worktreeRoots) {
    const relative = relativeInside(root.absolute, absoluteCwd);
    if (relative !== null) {
      return { root, relative, basePath: root.absolute };
    }
  }

  for (const root of worktreeRoots) {
    const relative = relativeInside(root.canonical, absoluteCwd);
    if (relative !== null) {
      return { root, relative, basePath: root.canonical };
    }
  }

  if (!fs.existsSync(absoluteCwd)) return null;
  const canonicalCwd = fs.realpathSync.native(absoluteCwd);

  for (const root of worktreeRoots) {
    const relative = relativeInside(root.canonical, canonicalCwd);
    if (relative !== null) {
      return { root, relative, basePath: root.canonical };
    }
  }

  return null;
}

/** Determine whether a CWD's configured worktree still exists. */
function classifyCwd(cwd) {
  const boundary = findWorktreeBoundary(cwd);
  if (boundary === null) return "preserved-outside-roots";

  const [worktreeName] = boundary.relative.split(path.sep).filter(Boolean);
  if (!worktreeName) return "preserved-container-root";

  const worktreePath = path.join(boundary.basePath, worktreeName);
  if (!fs.existsSync(worktreePath)) return "orphan-missing-worktree";
  if (missingOnly) return "preserved-existing";

  try {
    const reportedRoot = execFileSync(
      "git",
      ["-C", worktreePath, "rev-parse", "--show-toplevel"],
      { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
    ).trim();
    const canonicalWorktreePath = fs.realpathSync.native(worktreePath);
    const canonicalReportedRoot = fs.realpathSync.native(reportedRoot);
    if (canonicalWorktreePath === canonicalReportedRoot) {
      return "valid-worktree";
    }
  } catch {
    // An explicitly scoped worktree child exists but is no longer valid.
  }

  return "orphan-invalid-worktree";
}

/** Require persisted Git evidence before considering a thread orphaned. */
function classifyThread(thread) {
  if (!thread.git_sha && !thread.git_branch && !thread.git_origin_url) {
    return "preserved-no-git-metadata";
  }
  return classifyCwd(thread.cwd);
}

/** Collect all persisted descendants of a thread, including the thread. */
function collectSubtree(threadId, childrenByParent) {
  const result = [];
  const pending = [threadId];
  const visited = new Set();

  while (pending.length > 0) {
    const current = pending.pop();
    if (visited.has(current)) continue;
    visited.add(current);
    result.push(current);
    pending.push(...(childrenByParent.get(current) ?? []));
  }

  return result;
}

/** Reload a thread and all current descendants immediately before deletion. */
function readCurrentSubtree(stateDatabasePath, threadId) {
  const currentDatabase = new DatabaseSync(stateDatabasePath, {
    readOnly: true,
  });

  try {
    return currentDatabase
      .prepare(
        `WITH RECURSIVE subtree(id) AS (
           SELECT ?
           UNION
           SELECT edge.child_thread_id
             FROM thread_spawn_edges AS edge
             JOIN subtree ON edge.parent_thread_id = subtree.id
         )
         SELECT thread.id, thread.cwd, thread.is_pinned,
                thread.git_sha, thread.git_branch, thread.git_origin_url
           FROM threads AS thread
           JOIN subtree ON subtree.id = thread.id`,
      )
      .all(threadId);
  } finally {
    currentDatabase.close();
  }
}

const stateDatabase = findStateDatabase();
const database = new DatabaseSync(stateDatabase, { readOnly: true });
const threads = database
  .prepare(
    `SELECT id, cwd, rollout_path, updated_at, is_pinned, archived, source,
            thread_source,
            git_sha, git_branch, git_origin_url
       FROM threads`,
  )
  .all();
const edges = database
  .prepare(`SELECT parent_thread_id, child_thread_id FROM thread_spawn_edges`)
  .all();
database.close();

const parentByChild = new Map();

for (const edge of edges) {
  parentByChild.set(edge.child_thread_id, edge.parent_thread_id);
}

/** Return whether a persisted session source identifies a non-root agent. */
function isNonRootSessionSource(source) {
  try {
    const parsed = JSON.parse(source);
    return (
      parsed !== null &&
      typeof parsed === "object" &&
      (Object.hasOwn(parsed, "subagent") || Object.hasOwn(parsed, "internal"))
    );
  } catch {
    return false;
  }
}

/** Classify non-root threads without relying on complete spawn-edge history. */
function isSpawnedThread(thread, childToParent) {
  return (
    childToParent.has(thread.id) ||
    thread.thread_source === "subagent" ||
    thread.thread_source === "memory_consolidation" ||
    isNonRootSessionSource(thread.source)
  );
}

/** Format a byte count for compact terminal output. */
function formatBytes(bytes) {
  const units = ["B", "KiB", "MiB", "GiB", "TiB"];
  let value = bytes;
  let unitIndex = 0;

  while (value >= 1024 && unitIndex < units.length - 1) {
    value /= 1024;
    unitIndex += 1;
  }

  const fractionDigits = unitIndex === 0 ? 0 : value >= 10 ? 1 : 2;
  return `${value.toFixed(fractionDigits)} ${units[unitIndex]}`;
}

/** Format a Unix timestamp as an ISO calendar date. */
function formatDate(timestampSeconds) {
  if (!timestampSeconds) return "-";
  return new Date(timestampSeconds * 1000).toISOString().slice(0, 10);
}

/** Describe whether a recorded CWD is still an accessible directory. */
function directoryState(cwd) {
  try {
    return fs.statSync(cwd).isDirectory() ? "exists" : "not-dir";
  } catch (error) {
    if (error.code === "ENOENT" || error.code === "ENOTDIR") return "missing";
    return "error";
  }
}

/** Print a read-only inventory grouped by each thread's recorded CWD. */
function printDirectoryInventory(
  allThreads,
  childToParent,
  databasePath,
  sortBy,
) {
  const entriesByCwd = new Map();
  let unavailableRollouts = 0;

  for (const thread of allThreads) {
    const entry = entriesByCwd.get(thread.cwd) ?? {
      cwd: thread.cwd,
      state: directoryState(thread.cwd),
      threads: 0,
      conversations: 0,
      pinned: 0,
      archived: 0,
      bytes: 0,
      updatedAt: 0,
    };

    entry.threads += 1;
    if (!isSpawnedThread(thread, childToParent)) entry.conversations += 1;
    if (thread.is_pinned) entry.pinned += 1;
    if (thread.archived) entry.archived += 1;
    entry.updatedAt = Math.max(entry.updatedAt, thread.updated_at);

    try {
      entry.bytes += fs.statSync(thread.rollout_path).size;
    } catch {
      unavailableRollouts += 1;
    }

    entriesByCwd.set(thread.cwd, entry);
  }

  const compareEntries = inventorySortComparators.get(sortBy);
  const entries = [...entriesByCwd.values()].sort(
    (a, b) =>
      compareEntries(a, b) ||
      b.bytes - a.bytes ||
      b.threads - a.threads ||
      a.cwd.localeCompare(b.cwd),
  );
  const totalBytes = entries.reduce((sum, entry) => sum + entry.bytes, 0);

  console.log(`Codex state database: ${databasePath}`);
  console.log("Mode: DIRECTORY INVENTORY (read only)");
  console.log(`Persisted threads: ${allThreads.length}`);
  console.log(`Recorded working directories: ${entries.length}`);
  console.log(`Approximate rollout size: ${formatBytes(totalBytes)}`);
  console.log(`Unavailable rollout files: ${unavailableRollouts}`);
  console.log(`Sort: ${sortBy}`);
  console.log(
    `\n${"State".padEnd(8)} ${"Conversations".padStart(13)} ` +
      `${"Spawned".padStart(7)} ${"Threads".padStart(7)} ` +
      `${"Pinned".padStart(6)} ${"Archived".padStart(8)} ` +
      `${"Size".padStart(9)}  ${"Last used".padEnd(10)}  Working directory`,
  );

  for (const entry of entries) {
    const spawnedThreads = entry.threads - entry.conversations;
    console.log(
      `${entry.state.padEnd(8)} ` +
        `${entry.conversations.toString().padStart(13)} ` +
        `${spawnedThreads.toString().padStart(7)} ` +
        `${entry.threads.toString().padStart(7)} ` +
        `${entry.pinned.toString().padStart(6)} ` +
        `${entry.archived.toString().padStart(8)} ` +
        `${formatBytes(entry.bytes).padStart(9)}  ` +
        `${formatDate(entry.updatedAt).padEnd(10)}  ${entry.cwd}`,
    );
  }

  console.log("\nNo files were changed.");
}

if (inventory) {
  printDirectoryInventory(
    threads,
    parentByChild,
    stateDatabase,
    inventorySort,
  );
  process.exit(0);
}

const threadById = new Map(threads.map((thread) => [thread.id, thread]));
const childrenByParent = new Map();
for (const edge of edges) {
  const children = childrenByParent.get(edge.parent_thread_id) ?? [];
  children.push(edge.child_thread_id);
  childrenByParent.set(edge.parent_thread_id, children);
}

const isOrphanStatus = (status) => status.startsWith("orphan-");
const threadStatusById = new Map(
  threads.map((thread) => [thread.id, classifyThread(thread)]),
);
const candidateIds = new Set(
  threads
    .filter(
      (thread) =>
        !thread.is_pinned && isOrphanStatus(threadStatusById.get(thread.id)),
    )
    .map((thread) => thread.id),
);

const safeSubtreeCache = new Map();

/** Check that recursive deletion cannot remove a preserved descendant. */
function isEntireSubtreeCandidate(threadId, visiting = new Set()) {
  if (safeSubtreeCache.has(threadId)) return safeSubtreeCache.get(threadId);
  if (visiting.has(threadId)) return false;
  if (!candidateIds.has(threadId)) return false;

  const nextVisiting = new Set(visiting).add(threadId);
  const safe = (childrenByParent.get(threadId) ?? []).every((childId) =>
    isEntireSubtreeCandidate(childId, nextVisiting),
  );
  safeSubtreeCache.set(threadId, safe);
  return safe;
}

const safeIds = new Set(
  [...candidateIds].filter((threadId) => isEntireSubtreeCandidate(threadId)),
);
const deletionRootIds = [...safeIds].filter((threadId) => {
  const parentId = parentByChild.get(threadId);
  return parentId === undefined || !safeIds.has(parentId);
});
const coveredIds = new Set(
  deletionRootIds.flatMap((threadId) =>
    collectSubtree(threadId, childrenByParent),
  ),
);
const skippedUnsafeIds = [...candidateIds].filter(
  (threadId) => !coveredIds.has(threadId),
);

let orphanedBytes = 0;
for (const threadId of coveredIds) {
  const rolloutPath = threadById.get(threadId)?.rollout_path;
  if (!rolloutPath) continue;
  try {
    orphanedBytes += fs.statSync(rolloutPath).size;
  } catch {
    // Missing rollout files are already effectively reclaimed.
  }
}

const orphanedByCwd = new Map();
for (const thread of threads) {
  if (!candidateIds.has(thread.id)) continue;
  const entry = orphanedByCwd.get(thread.cwd) ?? {
    cwd: thread.cwd,
    reason: threadStatusById.get(thread.id),
    threads: 0,
  };
  entry.threads += 1;
  orphanedByCwd.set(thread.cwd, entry);
}

console.log(`Codex state database: ${stateDatabase}`);
console.log(`Mode: ${shouldApply ? "DELETE" : "DRY RUN"}`);
console.log("Worktree containers:");
for (const root of worktreeRoots) console.log(`  ${root.absolute}`);
console.log(`Persisted threads: ${threads.length}`);
console.log(`Orphaned, unpinned threads: ${candidateIds.size}`);
console.log(`Safe deletion roots: ${deletionRootIds.length}`);
console.log(`Threads covered recursively: ${coveredIds.size}`);
console.log(`Unsafe mixed subtrees skipped: ${skippedUnsafeIds.length}`);
console.log(`Approximate reclaimable size: ${formatBytes(orphanedBytes)}`);

const cwdEntries = [...orphanedByCwd.values()].sort(
  (a, b) => b.threads - a.threads || a.cwd.localeCompare(b.cwd),
);
const displayedEntries = verbose ? cwdEntries : cwdEntries.slice(0, 30);

console.log("\nOrphaned working directories:");
for (const entry of displayedEntries) {
  console.log(`${entry.threads.toString().padStart(5)}  ${entry.reason}  ${entry.cwd}`);
}
if (!verbose && displayedEntries.length < cwdEntries.length) {
  console.log(`... ${cwdEntries.length - displayedEntries.length} more; use --verbose`);
}

if (!shouldApply) {
  console.log("\nNo files were changed. Re-run with --apply to delete.");
  process.exit(0);
}

let deletedRoots = 0;
let failedRoots = 0;
let changedSinceScan = 0;

for (const [index, threadId] of deletionRootIds.entries()) {
  const currentSubtree = readCurrentSubtree(stateDatabase, threadId);
  const subtreeStillOrphaned =
    currentSubtree.length > 0 &&
    currentSubtree.every(
      (thread) =>
        !thread.is_pinned && isOrphanStatus(classifyThread(thread)),
    );

  if (!subtreeStillOrphaned) {
    changedSinceScan += 1;
    console.error(`Skipping ${threadId}: pin or worktree state changed`);
    continue;
  }

  console.log(`[${index + 1}/${deletionRootIds.length}] Deleting ${threadId}`);
  const result = spawnSync(codexBin, ["delete", threadId, "--force"], {
    stdio: "inherit",
  });

  if (result.status === 0) deletedRoots += 1;
  else failedRoots += 1;
}

console.log("\nDeletion summary:");
console.log(`Deleted roots: ${deletedRoots}`);
console.log(`Failed roots: ${failedRoots}`);
console.log(`Skipped after recheck: ${changedSinceScan}`);

if (failedRoots > 0 || changedSinceScan > 0) process.exitCode = 1;
