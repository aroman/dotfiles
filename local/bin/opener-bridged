#!/usr/bin/env python3
"""Open URLs from NixOS hosts in this Mac's browser.

    opener-bridged <host>...

The whole bridge, one process: it listens on 127.0.0.1:47831, dials every
<host> with `ssh -R` so the same endpoint exists there, and each host's
xdg-open shim (nixos/modules/home.nix) speaks one line each way:

    -> open <origin> <url>\n      origin = short hostname where xdg-open ran
    <- ok <final-url>\n  |  err <message>\n

Two jobs beyond handing the URL to open(1):

  * Normalise scheme.  Callers emit bare `localhost:4034`; macOS parses that
    as the URL scheme `localhost:` and fails with kLSApplicationNotFoundErr.

  * Rewrite loopback URLs.  `localhost:4034` names a port on the *remote*.
    We ask the tunnel's ControlMaster to forward an ephemeral local port
    there and hand the browser the rewritten address.  ssh resolves
    `localhost` on the far side, which is what reaches listeners bound to
    [::1] only -- most of them are, so a Tailscale hostname would not do.

Replying (rather than firing and forgetting) is the point of the request /
response shape: it is what lets the shim exit nonzero when nothing opened.
"""

import os
import re
import socket
import socketserver
import subprocess
import sys
import threading
import time
from urllib.parse import urlsplit, urlunsplit

ADDR = ("127.0.0.1", 47831)

# urlsplit().hostname lowercases and strips brackets from IPv6 literals.
LOOPBACK = {"localhost", "::1", "0.0.0.0", "::"}


def is_loopback(host):
    """Does `host` mean "the machine this URL came from"?"""
    # All of 127/8, not just 127.0.0.1 -- services do use 127.0.0.5 and the
    # like, and those would otherwise be opened against this Mac.
    return bool(host) and (host in LOOPBACK or host.startswith("127."))

DEFAULT_PORT = {"http": 80, "https": 443}

# origin reaches ssh as the host argument, so a leading `-` would be argument
# injection (-oProxyCommand=...).  Anchored, and no `-` in first position.
ORIGIN_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]*\Z")

SCHEME_RE = re.compile(r"\A[A-Za-z][A-Za-z0-9+.-]*:")

# `host:port` is indistinguishable from `scheme:opaque` by shape alone --
# `tel:5551234` and `localhost:4034` parse identically.  So only treat it as
# host:port when the host half actually looks like a host: bracketed IPv6,
# dotted name or IPv4, or the literal `localhost`.  Everything else keeps its
# scheme and passes through to open(1), preserving mailto:/tel:/zoom: today.
HOSTPORT_RE = re.compile(
    r"\A(\[[0-9A-Fa-f:]+\]"
    r"|localhost"
    r"|[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+"
    r"):\d+([/?#]|\Z)",
    re.IGNORECASE,  # `Localhost:4034` would otherwise fall through to open(1)
)

# A bare label with a port is ambiguous, but a path after it is not: no scheme
# in practice has a digits-then-slash opaque part.  Catches `wizardtower:80/x`.
HOSTPORT_PATH_RE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9-]*:\d+[/?#]")

# (origin, remote port) -> forwarded local port.  Keeps repeat opens of one
# dev server on one stable URL and one listener; a lost entry just means the
# next open picks a fresh ephemeral port and the old listener idles until
# the tunnel next reconnects.
FORWARDS = {}

# (origin, remote port) -> Lock serialising forward creation for that key
# (see localise); other keys and plain-URL opens stay concurrent.
FORWARD_LOCKS = {}


def log(msg):
    print("%s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg), flush=True)


def tunnel_master(host):
    """The ControlMaster socket of our own connection to `host`."""
    return os.path.expanduser("~/.ssh/opener-tunnel-%s" % host)


def hold_tunnel(host):
    """Keep one ssh to `host` alive, carrying 47831 back here.  Runs forever.

    ExitOnForwardFailure is the heart of it: a bind we cannot win (a stale
    session still holding the port after this Mac slept, say) is a nonzero
    exit, and the loop is the retry.  The connection doubles as the
    ControlMaster ssh_forward() asks for -L forwards -- its own socket, not
    the config's `cm-*`, so interactive sessions and the bridge cannot end
    each other.

    ControlPersist=no matters: ssh/config sets 10m for these hosts, and a
    persisting master forks to the background the moment -N leaves it idle --
    the child we supervise would exit 0 and the respawn would lose the 47831
    bind to the ghost it replaced.
    """
    ctl = tunnel_master(host)
    delay = 30
    last, repeats = None, 0
    while True:
        try:
            os.unlink(ctl)  # corpse from a kill/panic; we are its only owner
        except FileNotFoundError:
            pass
        started = time.monotonic()
        p = subprocess.Popen(
            ["/usr/bin/ssh", "-N", "-T",
             "-o", "BatchMode=yes",
             "-o", "ExitOnForwardFailure=yes",
             "-o", "ConnectTimeout=10",
             "-o", "ServerAliveInterval=15",
             "-o", "ServerAliveCountMax=4",
             "-o", "ControlMaster=yes",
             "-o", "ControlPath=%s" % ctl,
             "-o", "ControlPersist=no",
             "-R", "127.0.0.1:47831:127.0.0.1:47831",
             host],
            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        lines = []
        for line in p.stderr:  # ssh -N is silent except for trouble
            lines = (lines + [line.rstrip()])[-4:]
        code = p.wait()

        # An offline host (moonbinder is a laptop) would otherwise mean an
        # ssh spawn and two log lines every 40 seconds, forever, into a file
        # nothing rotates.  Consecutive identical failures double the delay
        # and are logged once.  The 120s cap is deliberate: reconnect latency
        # is the product — sit down at a freshly booted host and links should
        # just work — so this trades only the pointless retries, not the
        # responsive ones.
        if time.monotonic() - started > 60:
            # It connected and stayed up; its death is always news, and the
            # next failure is a fresh story.
            if repeats:
                log("[%s] (previous failure repeated %d times)" % (host, repeats))
            for l in lines:
                log("[%s] %s" % (host, l))
            log("[%s] tunnel exited %s after %dm up" %
                (host, code, (time.monotonic() - started) // 60))
            delay, last, repeats = 30, None, 0
        else:
            state = (tuple(lines), code)
            if state == last:
                repeats += 1
            else:
                if repeats:
                    log("[%s] (previous failure repeated %d times)" % (host, repeats))
                for l in lines:
                    log("[%s] %s" % (host, l))
                log("[%s] tunnel exited %s; retrying" % (host, code))
                last, repeats = state, 0
            delay = min(delay * 2, 120)
        time.sleep(delay)


def normalise(url):
    """Give `url` a scheme, or raise ValueError if it is not one.

    host:port is tested before the general scheme rule, since `localhost:4034`
    matches both and the host reading is the one we want.
    """
    if HOSTPORT_RE.match(url) or HOSTPORT_PATH_RE.match(url):
        return "http://" + url
    if SCHEME_RE.match(url):
        return url
    if ":" not in url:
        host = url.split("/", 1)[0]
        if host == "localhost" or "." in host:
            return "http://" + url
    raise ValueError("not a URL: %s" % url)


def free_port():
    s = socket.socket()
    try:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]
    finally:
        s.close()


def ssh_forward(origin, lport, rport):
    """Ask origin's tunnel master for -L 127.0.0.1:lport:localhost:rport.

    That master is the same connection this request just arrived through, so
    it is necessarily up.  Requesting a forward that already exists exits 0,
    so this is idempotent and needs no bookkeeping.
    """
    tunnel = tunnel_master(origin)
    if not os.path.exists(tunnel):
        raise ValueError("no tunnel to %s" % origin)
    return subprocess.run(
        ["/usr/bin/ssh", "-O", "forward",
         "-L", "127.0.0.1:%d:localhost:%d" % (lport, rport),
         "-S", tunnel, origin],
        capture_output=True, text=True, timeout=10,
    )


def rewrite(parts, lport):
    """Point `parts` at a local port, keeping any credentials."""
    userinfo = ""
    if parts.username:
        userinfo = parts.username
        if parts.password:
            userinfo += ":" + parts.password
        userinfo += "@"
    return urlunsplit(parts._replace(netloc="%s127.0.0.1:%d" % (userinfo, lport)))


def localise(url, origin):
    """Rewrite a loopback URL on `origin` to a forwarded port on this Mac.

    The local port is always an OS-assigned ephemeral one, never the remote's
    own number.  The master holding the forward lives as long as the tunnel
    does, so a listener on a recognisable port (3000, 4001...) would squat it
    for weeks against exactly the local dev servers and tailport forwards
    that want it -- worse, a later local server can bind [::1] while the
    forward holds 127.0.0.1, and `localhost:4001` then reaches a different
    machine per address family.  Ephemeral listeners collide with nothing
    anyone types.

    Only `ssh -O forward` exiting 0 proves the listener on a port belongs to
    *origin's* master.  Probing the port instead would also succeed against
    another host's forward, or a local process that grabbed it after a master
    lapsed -- and we would then open the wrong machine's server and call it
    ok, which is the whole failure class this daemon exists to remove.  So
    the cached port is re-asserted, never trusted: the call is idempotent,
    costs one mux round-trip, and re-binds the port on the new master after
    a reconnect.
    """
    parts = urlsplit(url)
    rport = parts.port or DEFAULT_PORT.get(parts.scheme)
    if rport is None:
        raise ValueError("no port in %s" % url)

    # Per-key lock: two concurrent first opens of the same dev server would
    # otherwise each install its own ephemeral forward, and the loser's
    # listener would idle untracked until the tunnel next reconnects.
    # dict.setdefault is atomic under the GIL, so the registry needs no lock
    # of its own; it grows exactly as FORWARDS does.
    with FORWARD_LOCKS.setdefault((origin, rport), threading.Lock()):
        cached = FORWARDS.get((origin, rport))
        if cached is not None:
            last = ssh_forward(origin, cached, rport)
            if last.returncode == 0:
                return rewrite(parts, cached), cached

        # First open of this port, or the cached one was lost to another
        # process while the tunnel was down: bind a fresh ephemeral port.
        # free_port() closes its probe before ssh binds -- a TOCTOU window --
        # and the mux client only reports "failed", never why (the bind error
        # lands on the master's stderr, i.e. in the tunnel log).  So a lost
        # race is indistinguishable from any other failure: try a few fresh
        # ports before concluding the problem is not the port.
        for _ in range(3):
            lport = free_port()
            last = ssh_forward(origin, lport, rport)
            if last.returncode == 0:
                FORWARDS[(origin, rport)] = lport
                return rewrite(parts, lport), lport
            if "Control socket" in (last.stderr or ""):
                break  # tunnel is down; another port will not help

    err = [l for l in (last.stderr or "").strip().splitlines() if l]
    detail = err[-1] if err else "ssh exit %d" % last.returncode
    if "Control socket" in detail or "ControlPath" in detail:
        raise ValueError("tunnel to %s is down" % origin)
    raise ValueError("forward failed: %s" % detail)


class Handler(socketserver.StreamRequestHandler):
    timeout = 10

    def handle(self):
        # Outside the reply path: a client that connects and stalls trips
        # `timeout` above, and an uncaught socket.timeout would have
        # socketserver dump a traceback per occurrence.
        try:
            raw = self.rfile.readline(8193)
        except OSError:
            return
        if not raw.strip():
            return  # port scan / half-open connect; nothing to answer

        if len(raw) > 8192:
            # readline caps rather than raising, so without this a long request
            # would be silently truncated and the truncated URL then opened.
            self.reply("err request too long")
            return

        line = raw.decode("utf-8", "replace").strip()

        try:
            reply = "ok " + self.dispatch(line)
        except ValueError as e:
            reply = "err %s" % e
        except Exception as e:  # never let one bad request kill the daemon
            reply = "err %s: %s" % (type(e).__name__, e)

        log("%s -> %s" % (line, reply))
        self.reply(reply)

    def reply(self, text):
        try:
            self.wfile.write((text + "\n").encode())
        except OSError:
            pass

    def dispatch(self, line):
        fields = line.split(" ", 2)
        if len(fields) != 3 or fields[0] != "open":
            raise ValueError("expected: open <origin> <url>")
        _, origin, url = fields

        if not ORIGIN_RE.match(origin):
            raise ValueError("bad origin: %s" % origin)

        url = normalise(url)

        if is_loopback(urlsplit(url).hostname):
            url, _ = localise(url, origin)

        try:
            r = subprocess.run(["/usr/bin/open", url],
                               capture_output=True, text=True, timeout=15)
        except subprocess.TimeoutExpired:
            # Wedged LaunchServices.  Say so now rather than let the caller's
            # own timeout expire and have open(1) fire minutes later.
            raise ValueError("open timed out")
        if r.returncode != 0:
            detail = (r.stderr or "").strip().splitlines()
            raise ValueError("open failed: %s" %
                             (detail[-1] if detail else "exit %d" % r.returncode))
        return url


class Server(socketserver.ThreadingTCPServer):
    # Threaded because a handler blocks on `ssh -O forward` (up to 10s) and on
    # open(1) (up to 15s); one slow open must not queue every other host's
    # requests behind it.  Concurrent forwards for one (origin, port) are
    # harmless: a duplicate `-O forward` exits 0.
    allow_reuse_address = True
    daemon_threads = True


def main():
    hosts = sys.argv[1:]
    if not hosts:
        sys.exit("usage: opener-bridged <host>...")
    # Bind before dialing out, so the remote end of a tunnel never forwards
    # into nothing.
    try:
        server = Server(ADDR, Handler)
    except OSError as e:
        sys.exit("opener-bridged: cannot bind %s:%d: %s" % (ADDR[0], ADDR[1], e))
    for host in hosts:
        threading.Thread(target=hold_tunnel, args=(host,), daemon=True).start()
    log("listening on %s:%d, tunnels: %s" % (ADDR[0], ADDR[1], " ".join(hosts)))
    server.serve_forever()


if __name__ == "__main__":
    main()
