#!/usr/bin/env bash
# Show what the noctalia GUI has changed on top of the declarative config.
#
# Under v4 this copied the whole runtime settings.json back into the repo,
# because noctalia rewrote its own config in place and the repo copy was
# forever stale.  v5 doesn't work that way: nixos/noctalia.nix generates
# ~/.config/noctalia/config.toml (read-only), and the GUI writes *only* to
# ~/.local/state/noctalia/settings.toml, which layers on top of it.
#
# So there's nothing to copy back wholesale — the state file *is* the diff.
# Anything in it is a setting changed in the GUI that isn't yet in Nix.
# Promote what's worth keeping into nixos/noctalia.nix by hand, then delete the
# state file to prove the declarative config stands on its own.
set -euo pipefail

STATE="${NOCTALIA_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}/noctalia/settings.toml"

if [ ! -s "$STATE" ]; then
  echo "No GUI overrides — everything is coming from nixos/noctalia.nix."
  exit 0
fi

echo "GUI overrides currently shadowing nixos/noctalia.nix:"
echo "  $STATE"
echo
cat "$STATE"
echo
echo "── adopt: copy into nixos/noctalia.nix (programs.noctalia.settings), rebuild,"
echo "          then: rm $STATE"
echo "── discard: rm $STATE && noctalia msg config-reload"
