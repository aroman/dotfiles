#!/usr/bin/env bash
# Preview what packages would change if you update nixpkgs (or all inputs).
# Usage:
#   nix-check-updates           # update all inputs, show diff
#   nix-check-updates nixpkgs   # update just nixpkgs, show diff

set -euo pipefail

# Derive dotfiles root from this script's location (local/bin/ inside the repo)
FLAKE="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)/nixos"
HOST="moonbinder"
LOCKFILE="$FLAKE/flake.lock"

# Save current lock file; restore it on any exit (a failed build used to
# abort under set -e and leave the updated lock behind)
cp "$LOCKFILE" "$LOCKFILE.bak"
trap 'mv "$LOCKFILE.bak" "$LOCKFILE"; rm -f result' EXIT

# Update inputs
if [ $# -gt 0 ]; then
    echo "Updating input: $*"
    nix flake update "$@" --flake "$FLAKE"
else
    echo "Updating all inputs..."
    nix flake update --flake "$FLAKE"
fi

# Build without switching
echo "Building new system (not switching)..."
nixos-rebuild build --flake "$FLAKE#$HOST"

# Show diff
echo ""
nix run nixpkgs#nvd -- diff /run/current-system ./result

echo ""
echo "Lock file restored. Run 'nix flake update --flake $FLAKE' + rebuild to apply."
